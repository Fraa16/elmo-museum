---
import { Picture } from 'astro:assets';
import { stationPath, type Station } from '../data/stations';
import { stationImage, widthsFor } from '../lib/images';

interface Props {
  station: Station;
  /** Bilder oberhalb der Falz sofort laden. */
  eager?: boolean;
}

const { station, eager = false } = Astro.props;
const image = stationImage(station.image);
---

<a class="card" href={stationPath(station)}>
  <Picture
    src={image}
    alt=""
    formats={['avif', 'webp']}
    widths={widthsFor(image, [280, 400, 640, 800])}
    sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 7.5rem"
    quality={70}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="card__img"
  />
  <span class="card__body">
    <span class="card__title"><span class="card__num">{station.id}</span>{station.title}</span>
    <span class="card__place">{station.kicker}</span>
  </span>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: center;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 200ms var(--ease);
  }

  .card:hover {
    border-color: var(--gold);
    color: var(--text);
  }

  .card :global(picture) {
    display: block;
  }

  .card__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.75rem 1rem;
  }

  .card :global(picture) {
    height: 100%;
  }

  @media (min-width: 40rem) {
    .card {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .card :global(picture) {
      height: auto;
    }

    .card__img {
      height: auto;
      aspect-ratio: 3 / 2;
    }

    .card__body {
      padding: 1rem 1.125rem 1.125rem;
    }
  }

  .card__num {
    margin-right: 0.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    color: var(--gold);
    font-variant-numeric: lining-nums;
  }

  .card__title {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.15;
  }

  .card__place {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    hyphens: manual;
    text-wrap: balance;
  }
</style>
