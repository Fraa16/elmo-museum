---
/**
 * Bild im Bogen libanesischer Häuser: echtes Foto oder Platzhalter.
 * Höhe kommt vom Aufrufer (Klasse oder style), der Bogen füllt sie.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { widthsFor } from '../../lib/images';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Beschriftung, solange es kein Foto gibt. */
  placeholder?: string;
  /** Feine Goldlinie mit Abstand um den Bogen. */
  framed?: boolean;
  sizes?: string;
  eager?: boolean;
  /** Wichtigstes Bild der Seite (LCP): früh laden. */
  priority?: boolean;
  /** CSS object-position für den Ausschnitt. */
  position?: string;
  /** Bogen öffnet sich beim Einblenden von unten (data-reveal="arch"). */
  reveal?: boolean;
  /** Dunkler Verlauf von links, damit darüber laufender Text lesbar bleibt. */
  shade?: boolean;
  class?: string;
  style?: string;
}

const {
  image,
  alt = '',
  placeholder = 'Foto folgt',
  framed = false,
  sizes = '(min-width: 64rem) 33vw, 100vw',
  eager = false,
  priority = false,
  position,
  reveal = false,
  shade = false,
  class: className,
  style,
} = Astro.props;
---

<div class:list={['archbox', { 'archbox--framed': framed }, className]} style={style} data-reveal={reveal ? 'arch' : undefined}>
  <div class="arch archbox__inner">
    {
      image ? (
        <Picture
          src={image}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widthsFor(image, [400, 640, 960, 1280])}
          sizes={sizes}
          quality={60}
          loading={eager || priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          class="archbox__img"
          style={position ? `object-position: ${position}` : undefined}
        />
      ) : (
        <PhotoPlaceholder label={placeholder} />
      )
    }
    {shade && <div class="archbox__shade" aria-hidden="true" />}
  </div>
</div>

<style>
  .archbox {
    position: relative;
  }

  .archbox__inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .archbox__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(20, 18, 14, 0.82) 0%,
      rgba(20, 18, 14, 0.55) 30%,
      rgba(20, 18, 14, 0.18) 52%,
      rgba(20, 18, 14, 0) 66%
    );
  }

  .archbox--framed {
    padding: 0.75rem;
    border: 1px solid var(--gold-line);
    border-radius: 9999px 9999px 0 0;
  }

  .archbox :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .archbox__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
