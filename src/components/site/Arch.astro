---
/**
 * Bild im Bogen libanesischer Häuser: echtes Foto oder Platzhalter.
 * Höhe kommt vom Aufrufer (Klasse oder style), der Bogen füllt sie.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { widthsFor } from '../../lib/images';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Beschriftung, solange es kein Foto gibt. */
  placeholder?: string;
  /** Feine Goldlinie mit Abstand um den Bogen. */
  framed?: boolean;
  sizes?: string;
  eager?: boolean;
  /** CSS object-position für den Ausschnitt. */
  position?: string;
  class?: string;
  style?: string;
}

const {
  image,
  alt = '',
  placeholder = 'Foto folgt',
  framed = false,
  sizes = '(min-width: 64rem) 33vw, 100vw',
  eager = false,
  position,
  class: className,
  style,
} = Astro.props;
---

<div class:list={['archbox', { 'archbox--framed': framed }, className]} style={style}>
  <div class="arch archbox__inner">
    {
      image ? (
        <Picture
          src={image}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widthsFor(image, [400, 640, 960, 1280])}
          sizes={sizes}
          quality={60}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="archbox__img"
          style={position ? `object-position: ${position}` : undefined}
        />
      ) : (
        <PhotoPlaceholder label={placeholder} />
      )
    }
  </div>
</div>

<style>
  .archbox {
    position: relative;
  }

  .archbox__inner {
    width: 100%;
    height: 100%;
  }

  .archbox--framed {
    padding: 0.75rem;
    border: 1px solid var(--gold-line);
    border-radius: 9999px 9999px 0 0;
  }

  .archbox :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .archbox__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
