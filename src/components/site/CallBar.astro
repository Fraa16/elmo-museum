---
import { restaurant, routeHref } from '../../data/restaurant';
---

<nav class="callbar" aria-label="Schnellzugriff">
  <a class="callbar__call" href={restaurant.phoneHref}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
    </svg>
    Anrufen
  </a>
  <a href={routeHref} rel="noopener">Route</a>
  <a href="/speisekarte">Karte</a>
</nav>

<style>
  .callbar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 20;
    display: flex;
    padding-bottom: env(safe-area-inset-bottom, 0);
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .callbar a {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.75rem;
    color: var(--text);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .callbar a + a {
    border-left: 1px solid var(--line);
  }

  .callbar .callbar__call {
    background: var(--gold);
    color: var(--bg);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .callbar {
      display: none;
    }
  }
</style>
