---
import Logo from './Logo.astro';
import { restaurant } from '../../data/restaurant';
import { NAV } from './nav';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`));
const sheetItems = [{ href: '/', label: 'Start' }, ...NAV, { href: '/gutscheine', label: 'Gutscheine' }, { href: '/kontakt', label: 'Kontakt' }];
---

<header class="header">
  <div class="header__inner page">
    <a class="header__brand" href="/" aria-label={`${restaurant.name}, zur Startseite`}>
      <Logo height={48} class="header__logo" />
    </a>

    <nav class="header__nav" aria-label="Hauptmenü">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="header__phone" href={restaurant.phoneHref}>{restaurant.phone}</a>
    </nav>

    <div class="header__mobile">
      <a class="header__call" href={restaurant.phoneHref} aria-label={`Anrufen: ${restaurant.phone}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
        </svg>
      </a>
      <button class="header__menu" type="button" popovertarget="site-menu" aria-label="Menü öffnen">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="site-menu" class="sheet" popover>
    <div class="sheet__top page">
      <Logo small />
      <button class="header__menu" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="Menü schließen">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav class="sheet__nav page" aria-label="Hauptmenü">
      {
        sheetItems.map((item, i) => (
          <a href={item.href} style={`--i: ${i}`} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="sheet__in">{item.label}</span>
          </a>
        ))
      }
    </nav>
    <div class="sheet__foot page">
      <a class="btn btn--solid" href={restaurant.phoneHref}>Anrufen: {restaurant.phone}<span aria-hidden="true">→</span></a>
      <p>{restaurant.street}, {restaurant.postalCode} {restaurant.city}</p>
    </div>
  </div>
</header>

<style>
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-top: calc(0.75rem + env(safe-area-inset-top, 0));
    padding-bottom: 0.75rem;
  }

  .header__brand {
    display: inline-flex;
    text-decoration: none;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 2.25rem;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .header__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    text-decoration: none;
    transition: color 300ms var(--ease-out);
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--gold-soft);
  }

  /* feine Goldlinie, wächst beim Hovern von links */
  .header__nav a:not(.header__phone)::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.55rem;
    left: 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 600ms var(--ease-out);
  }

  .header__nav a:not(.header__phone):hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__nav .header__phone {
    padding-inline: 1.25rem;
    border: 1px solid var(--gold);
    color: var(--gold-soft);
    transition: background-color 400ms var(--ease-out), color 400ms var(--ease-out);
  }

  .header__nav .header__phone:hover {
    background: var(--gold);
    color: var(--bg);
  }

  .header__mobile {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--gold-soft);
  }

  .header__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  @media (max-width: 47.99rem) {
    .header :global(.header__logo) {
      --logo-h: 38px;
    }
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: flex;
    }

    .header__mobile {
      display: none;
    }
  }

  /* Menü auf dem Handy: ganze Fläche, ohne eigenes JS (Popover-API) */
  .sheet {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
    flex-direction: column;
  }

  .sheet:popover-open {
    display: flex;
  }

  .sheet::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .sheet__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    padding-top: calc(0.75rem + env(safe-area-inset-top, 0));
  }

  .sheet__nav {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
  }

  .sheet__nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    overflow: hidden;
    font-family: var(--font-head);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
  }

  /* Trennlinie als eigenes Element, damit sie sich aufziehen kann */
  .sheet__nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  .sheet__in {
    display: block;
    padding-bottom: 0.08em;
  }

  .sheet__nav a[aria-current='page'] {
    color: var(--gold-soft);
    font-style: italic;
  }

  .sheet__foot {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0));
    color: var(--muted-2);
    font-size: 0.9375rem;
  }

  /* Seite dahinter nicht mitscrollen, solange das Menü offen ist */
  :global(html:has(#site-menu:popover-open)) {
    overflow: hidden;
  }

  /*
   * Menü-Animation: Der Vorhang zieht von oben auf, dann steigen die Einträge
   * nacheinander aus ihrer Maske und die Linien ziehen sich von links auf.
   * Schließen: Vorhang fährt zügig nach oben zurück. Reine CSS (@starting-style);
   * ältere Browser zeigen das Menü einfach ohne Bewegung.
   */
  @media (prefers-reduced-motion: no-preference) {
    .sheet {
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 520ms var(--ease-in-out),
        overlay 520ms allow-discrete,
        display 520ms allow-discrete;
    }

    .sheet:popover-open {
      clip-path: inset(0 0 0 0);
      transition-duration: 760ms;
    }

    @starting-style {
      .sheet:popover-open {
        clip-path: inset(0 0 100% 0);
      }
    }

    .sheet::backdrop {
      background: rgba(0, 0, 0, 0);
      transition:
        background-color 520ms var(--ease-in-out),
        overlay 520ms allow-discrete,
        display 520ms allow-discrete;
    }

    .sheet:popover-open::backdrop {
      background: rgba(0, 0, 0, 0.6);
    }

    @starting-style {
      .sheet:popover-open::backdrop {
        background: rgba(0, 0, 0, 0);
      }
    }

    .sheet__top,
    .sheet__foot {
      opacity: 0;
      transform: translate3d(0, -0.5rem, 0);
      transition:
        opacity 400ms var(--ease-out),
        transform 600ms var(--ease-out);
    }

    .sheet__foot {
      transform: translate3d(0, 1rem, 0);
    }

    .sheet:popover-open .sheet__top {
      opacity: 1;
      transform: none;
      transition-delay: 200ms;
    }

    .sheet:popover-open .sheet__foot {
      opacity: 1;
      transform: none;
      transition-delay: calc(420ms + 7 * 55ms);
    }

    .sheet__in {
      transform: translate3d(0, 110%, 0);
      transition: transform 380ms var(--ease-in-out);
    }

    .sheet__nav a::after {
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 380ms var(--ease-in-out);
    }

    .sheet:popover-open .sheet__in {
      transform: none;
      transition: transform 900ms var(--ease-out);
      transition-delay: calc(300ms + var(--i) * 55ms);
    }

    .sheet:popover-open a::after {
      transform: scaleX(1);
      transition: transform 1000ms var(--ease-out);
      transition-delay: calc(360ms + var(--i) * 55ms);
    }

    @starting-style {
      .sheet:popover-open .sheet__top,
      .sheet:popover-open .sheet__foot {
        opacity: 0;
      }

      .sheet:popover-open .sheet__in {
        transform: translate3d(0, 110%, 0);
      }

      .sheet:popover-open a::after {
        transform: scaleX(0);
      }
    }
  }
</style>
