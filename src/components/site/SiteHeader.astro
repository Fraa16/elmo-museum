---
import Logo from './Logo.astro';
import { restaurant } from '../../data/restaurant';
import { NAV } from './nav';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`));
---

<header class="header">
  <div class="header__inner page">
    <a class="header__brand" href="/" aria-label={`${restaurant.name}, zur Startseite`}>
      <Logo height={48} class="header__logo" />
    </a>

    <nav class="header__nav" aria-label="Hauptmenü">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="header__phone" href={restaurant.phoneHref}>{restaurant.phone}</a>
    </nav>

    <button class="header__menu" type="button" popovertarget="site-menu" aria-label="Menü öffnen">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M4 8h16M4 16h16"></path>
      </svg>
    </button>
  </div>

  <div id="site-menu" class="sheet" popover>
    <div class="sheet__top page">
      <Logo height={38} />
      <button class="header__menu" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="Menü schließen">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav class="sheet__nav page" aria-label="Hauptmenü">
      <a href="/" aria-current={current === '/' ? 'page' : undefined}>Start</a>
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href="/gutscheine" aria-current={isCurrent('/gutscheine') ? 'page' : undefined}>Gutscheine</a>
      <a href="/kontakt" aria-current={isCurrent('/kontakt') ? 'page' : undefined}>Kontakt</a>
    </nav>
    <div class="sheet__foot page">
      <a class="btn btn--solid" href={restaurant.phoneHref}>Anrufen: {restaurant.phone}<span aria-hidden="true">→</span></a>
      <p>{restaurant.street}, {restaurant.postalCode} {restaurant.city}</p>
    </div>
  </div>
</header>

<style>
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-top: calc(0.75rem + env(safe-area-inset-top, 0));
    padding-bottom: 0.75rem;
  }

  .header__brand {
    display: inline-flex;
    text-decoration: none;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 2.25rem;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    text-decoration: none;
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--gold-soft);
  }

  .header__nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.5em;
  }

  .header__nav .header__phone {
    padding-inline: 1.25rem;
    border: 1px solid var(--gold);
    color: var(--gold-soft);
  }

  .header__nav .header__phone:hover {
    background: var(--gold);
    color: var(--bg);
  }

  .header__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  @media (max-width: 47.99rem) {
    .header :global(.header__logo .logo__emblem) {
      height: 38px;
      width: auto;
    }

    .header :global(.header__logo .logo__word) {
      font-size: 0.625rem;
    }
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: flex;
    }

    .header__menu {
      display: none;
    }
  }

  /* Menü auf dem Handy: ganze Fläche, ohne eigenes JS (Popover-API) */
  .sheet {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
    flex-direction: column;
  }

  .sheet:popover-open {
    display: flex;
  }

  .sheet::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .sheet__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    padding-top: calc(0.75rem + env(safe-area-inset-top, 0));
  }

  .sheet__nav {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
  }

  .sheet__nav a {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-head);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
  }

  .sheet__nav a[aria-current='page'] {
    color: var(--gold-soft);
    font-style: italic;
  }

  .sheet__foot {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0));
    color: var(--muted-2);
    font-size: 0.9375rem;
  }
</style>
