---
import { openingHours } from '../../data/restaurant';

interface Props {
  /** Kurze Tagesnamen („Mo bis Do“) statt langer. */
  short?: boolean;
  class?: string;
}

const { short = false, class: className } = Astro.props;
---

<dl class:list={['hours', className]}>
  {
    openingHours.map((slot) => (
      <div class="hours__row" data-hours-days={slot.days.join(',')}>
        <dt>
          <span class="hours__dot" aria-hidden="true" />
          {short ? slot.short : slot.label}
        </dt>
        <dd>
          {slot.opens} bis {slot.closes}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .hours {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .hours__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .hours__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: transparent;
  }

  .hours__row:global(.is-today) .hours__dot {
    background: var(--open);
  }
</style>
