---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden" noindex>
  <main class="notfound wrap">
    <p class="kicker">Fehler 404</p>
    <h1 class="notfound__title display">Diese Seite gibt es <em>nicht.</em></h1>
    <p class="notfound__text">Vielleicht hilft dir die Startseite, die Speisekarte oder unser kleines Museum weiter.</p>
    <div class="notfound__links">
      <a class="btn btn--solid" href="/">Zur Startseite<span aria-hidden="true"><svg class="i-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></a>
      <a class="btn" href="/speisekarte">Speisekarte<span aria-hidden="true"><svg class="i-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></a>
      <a class="btn" href="/museum">Museum<span aria-hidden="true"><svg class="i-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></a>
    </div>
  </main>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-top: 5rem;
    text-align: center;
  }

  .notfound__title {
    font-size: clamp(3.5rem, 12vw, 6rem);
  }

  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .notfound__text {
    max-width: 30rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
</style>
