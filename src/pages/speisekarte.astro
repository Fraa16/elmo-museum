---
import '@fontsource/reem-kufi/arabic-600.css';
import '@fontsource/noto-naskh-arabic/arabic-500.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import DishRow from '../components/site/DishRow.astro';
import CallBand from '../components/site/CallBand.astro';
import { restaurant } from '../data/restaurant';
import { dishCount, formatPrice, glossary, menu } from '../data/menu';

const half = (n: number) => Math.ceil(n / 2);
---

<BaseLayout
  title="Speisekarte"
  description={`Alle ${dishCount} Gerichte von Elmo Shawarma: Shawarma vom Spieß, Burger, Broasted, Grillteller, Mezze und Suppen. Vegan und vegetarisch markiert.`}
>
  <main>
    <PageHero
      label="Speisekarte"
      title="Die <em>Karte.</em>"
      ar="قائمة الطعام"
      intro={`${dishCount} Gerichte, alles handgemacht und frisch zubereitet. Vorbestellen und abholen per Telefon.`}
    >
      <div class="legend">
        <a class="btn btn--solid" href={restaurant.phoneHref}>Anrufen und vorbestellen<span aria-hidden="true">→</span></a>
        <p class="legend__text">
          <span class="legend__tag legend__tag--vegan">Vegan</span>{' und '}<span class="legend__tag legend__tag--veg">Vegetarisch</span> stehen beim Gericht. Batata sind handgeschnittene Kartoffeln.
        </p>
      </div>
    </PageHero>

    <nav class="jump" aria-label="Kategorien">
      <ul class="jump__list page">
        {
          menu.map((cat) => (
            <li>
              <a href={`#${cat.id}`}>{cat.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="card">
      {
        menu.map((cat) => (
          <section id={cat.id} class="cat page" aria-labelledby={`${cat.id}-title`}>
            <header class="cat__head" data-reveal>
              <h2 id={`${cat.id}-title`} class="display cat__title">
                {cat.title}
              </h2>
              {(cat.intro || cat.extras) && (
                <p class="cat__intro">
                  {cat.intro}
                  {cat.extras && (
                    <span class="cat__extras">
                      {' '}
                      Extra: {cat.extras.map((e) => `${e.label} +${formatPrice(e.price)}`).join(', ')}.
                    </span>
                  )}
                </p>
              )}
            </header>
            <div class="cat__grid">
              {[cat.items.slice(0, half(cat.items.length)), cat.items.slice(half(cat.items.length))].map((column) => (
                <div class="cat__col" data-reveal-stagger="60">
                  {column.map((dish) => (
                    <DishRow dish={dish} />
                  ))}
                </div>
              ))}
            </div>
          </section>
        ))
      }

      <section class="words page" aria-labelledby="words-title">
        <h2 id="words-title" class="display words__title" data-reveal="mask"><span class="mask__in">Kleines <em>Wörterbuch.</em></span></h2>
        <dl class="words__list" data-reveal-stagger="50">
          {
            glossary.map((entry) => (
              <div class="words__item" data-reveal>
                <dt>{entry.term}</dt>
                <dd>{entry.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="words__note">Preise in Euro inkl. MwSt. Getränke zzgl. Pfand. Fragen zu Allergenen beantworten wir dir gern im Restaurant.</p>
      </section>
    </div>

    <CallBand />
  </main>
</BaseLayout>

<style>
  .legend {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .legend .btn {
    align-self: flex-start;
  }

  .legend__text {
    max-width: 30rem;
    font-size: 0.9375rem;
    color: var(--muted-2);
  }

  .legend__tag {
    font-weight: 600;
  }

  .legend__tag--vegan,
  .legend__tag--veg {
    color: #8fbf7a;
  }

  /* Sprungleiste */
  .jump {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--stone);
    border-bottom: 1px solid var(--ink-line);
  }

  .jump__list {
    display: flex;
    gap: 0.5rem;
    margin: 0 auto;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--ink-line);
    color: var(--ink);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .jump a:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--stone);
  }

  /* Karte auf Kalkstein */
  .card {
    background: var(--stone);
    color: var(--ink);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cat {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    scroll-margin-top: 4rem;
  }

  .cat__head {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
  }

  .cat__title {
    font-size: clamp(3rem, 6vw, 5.25rem);
    line-height: 0.92;
  }

  .cat__intro {
    max-width: 34rem;
    color: var(--ink-muted);
  }

  .cat__extras {
    white-space: nowrap;
  }

  .cat__col > :global(:last-child) {
    border-bottom: 0;
  }

  .words {
    padding-top: clamp(4.5rem, 9vw, 7.5rem);
    scroll-margin-top: 4rem;
  }

  .words__title {
    font-size: clamp(3rem, 6vw, 5.25rem);
  }

  .words__title :global(em) {
    color: var(--ink-gold);
  }

  .words__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0 3rem;
    margin: 2rem 0 0;
    border-top: 2px solid var(--ink);
  }

  .words__item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--ink-line);
  }

  .words__item dt {
    font-family: var(--font-head);
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .words__item dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .words__note {
    margin-top: 2.5rem;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .legend {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }

    .cat__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: end;
    }

    .cat__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 6rem;
    }
  }
</style>
