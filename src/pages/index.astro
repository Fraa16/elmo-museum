---
import '@fontsource/reem-kufi/arabic-600.css';
import '@fontsource/noto-naskh-arabic/arabic-500.css';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arch from '../components/site/Arch.astro';
import Ticker from '../components/site/Ticker.astro';
import DishRow from '../components/site/DishRow.astro';
import HoursTable from '../components/site/HoursTable.astro';
import OpenStatus from '../components/site/OpenStatus.astro';
import { SITE_URL } from '../config';
import { restaurant, restaurantJsonLd, routeHref } from '../data/restaurant';
import { dishCount, featuredDishes } from '../data/menu';
import { stationPath, stations } from '../data/stations';
import { stationImage } from '../lib/images';

const roots = stationImage('01.jpg');
const museumImages = [
  { id: '02', alt: 'Bacchustempel in Baalbek', tall: false },
  { id: '04', alt: 'Felsendom in Jerusalem', tall: true },
  { id: '09', alt: 'Seeburg von Sidon', tall: false },
].map((item) => {
  const station = stations.find((s) => s.id === item.id)!;
  return { ...item, image: stationImage(station.image), href: stationPath(station), title: station.title };
});
const numberWords: Record<number, string> = { 10: 'Zehn', 11: 'Elf', 12: 'Zwölf', 13: 'Dreizehn', 14: 'Vierzehn', 15: 'Fünfzehn' };
const count = numberWords[stations.length] ?? String(stations.length);

const featured = featuredDishes();

const og = await getImage({ src: roots, width: 1200, format: 'jpg', quality: 80 });
const ogImage = new URL(og.src, SITE_URL).href;

const steps = [
  { num: '01', title: 'Selbst mariniert', text: 'Das Hähnchen für den Spieß.', placeholder: 'Foto: Marinade' },
  { num: '02', title: 'Von Hand geschichtet', text: 'Schicht für Schicht auf den Spieß.', placeholder: 'Foto: Hände am Spieß' },
  { num: '03', title: 'Von Hand geformt', text: 'Kafta nach libanesischer Art.', placeholder: 'Foto: Kafta formen' },
];
---

<BaseLayout
  title={restaurant.name}
  fullTitle="Elmo Shawarma | Libanesische Küche in Schwäbisch Gmünd"
  ogImage={ogImage}
  ogImageAlt="Sonnenuntergang über dem Mittelmeer an der Küste von Al Bayada im Südlibanon"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(restaurantJsonLd(SITE_URL))} />

  <main>
    <section class="hero page" aria-labelledby="hero-title">
      <div class="hero__label" data-reveal style="--d: 60ms">
        <p class="label">Libanesische Küche<span class="hero__city"> in {restaurant.city}</span></p>
        <span class="hero__rule" aria-hidden="true"></span>
        <p class="kufi hero__ar" lang="ar" dir="rtl">أهلاً وسهلاً</p>
      </div>
      <h1 id="hero-title" class="hero__title display">
        <span class="line" data-reveal="mask" style="--d: 140ms"><span class="mask__in">Alles</span></span>
        <span class="line" data-reveal="mask" style="--d: 240ms"><span class="mask__in">von Hand.</span></span>
        <span class="line" data-reveal="mask" style="--d: 340ms"><em class="mask__in">Frisch vom Spieß.</em></span>
      </h1>
      <Arch framed eager reveal placeholder="Foto: Shawarma vom Spieß" class="hero__arch" style="--d: 260ms" />
      <div class="hero__bottom" data-reveal style="--d: 720ms">
        <p class="hero__text">
          Hähnchen selbst mariniert und von Hand geschichtet. Kafta von Hand geformt. Falafel, Ayran und Joghurt aus
          unserer Küche.
        </p>
        <div class="hero__actions">
          <a class="btn btn--solid" href={restaurant.phoneHref}>Anrufen und abholen<span aria-hidden="true">→</span></a>
          <OpenStatus />
        </div>
      </div>
    </section>

    <Ticker />

    <section class="hand page" aria-labelledby="hand-title">
      <div class="hand__head">
        <h2 id="hand-title" class="display hand__title" data-reveal="mask"><span class="mask__in">Was bei uns <em>von Hand</em> passiert.</span></h2>
        <p class="hand__text" data-reveal style="--d: 150ms">
          Wir marinieren, schichten und formen selbst, in unserer Küche in {restaurant.city}. Alles handgemacht und frisch
          zubereitet.
        </p>
      </div>
      <ol class="hand__steps" role="list">
        {
          steps.map((step, i) => (
            <li class="hand__step">
              <Arch reveal placeholder={step.placeholder} class={`hand__arch hand__arch--${i + 1}`} style={`--d: ${i * 140}ms`} />
              <div class="hand__caption" data-reveal style={`--d: ${i * 140 + 300}ms`}>
                <span class="hand__num" aria-hidden="true">{step.num}</span>
                <h3 class="hand__name">{step.title}</h3>
                <p class="hand__desc">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="hand__more" data-reveal>Außerdem aus unserer Küche: Falafel, Ayran und Joghurt. Und die Batata schneiden wir von Hand.</p>
    </section>

    <section class="menu" aria-labelledby="menu-title">
      <div class="page">
        <div class="menu__head">
          <h2 id="menu-title" class="display menu__title" data-reveal="mask"><span class="mask__in">Die Karte</span></h2>
          <div class="menu__meta" data-reveal style="--d: 150ms">
            <p class="kufi menu__ar" lang="ar" dir="rtl">قائمة الطعام</p>
            <p>Eine Auswahl aus {dishCount} Gerichten. Preise in Euro.</p>
          </div>
        </div>
        <div class="menu__grid">
          {
            [featured.slice(0, 4), featured.slice(4)].map((column) => (
              <div class="menu__col" data-reveal-stagger="70">
                {column.map((dish) => (
                  <DishRow dish={dish} />
                ))}
              </div>
            ))
          }
        </div>
        <div class="menu__foot" data-reveal>
          <a class="btn btn--ink" href="/speisekarte">Ganze Speisekarte<span aria-hidden="true">→</span></a>
          <p>Vorbestellen und abholen: <a href={restaurant.phoneHref}>{restaurant.phone}</a></p>
        </div>
      </div>
    </section>

    <section class="roots" aria-labelledby="roots-title" data-parallax-box>
      <Picture
        src={roots}
        alt="Sonnenuntergang über dem Mittelmeer an der Küste von Al Bayada im Südlibanon"
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
        quality={55}
        loading="lazy"
        decoding="async"
        class="roots__img"
        data-parallax
      />
      <div class="roots__shade" aria-hidden="true"></div>
      <div class="roots__body page" data-reveal-stagger="120">
        <p class="label roots__label" data-reveal>Al Bayada, Südlibanon</p>
        <h2 id="roots-title" class="display roots__title" data-reveal="mask"><span class="mask__in">Hier liegen unsere <em>Wurzeln.</em></span></h2>
        <p class="roots__text" data-reveal>Aus dieser Gegend stammt unsere Familie, lange bevor es {restaurant.name} in {restaurant.city} gab.</p>
        <a class="link-arrow" href="/ueber-uns" data-reveal>Unsere Geschichte<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="visit page" aria-labelledby="visit-title">
      <div data-reveal>
        <p id="visit-title" class="label">Vorbestellen, abholen, reservieren</p>
        <a class="visit__phone display" href={restaurant.phoneHref}>{restaurant.phone}</a>
        <p class="visit__text">Ruf an und bestell vor, dann holst du dein Essen einfach ab. Tische reservieren wir dir auch telefonisch.</p>
        <p class="visit__address">{restaurant.name}<br />{restaurant.street}<br />{restaurant.postalCode} {restaurant.city}</p>
        <a class="link-arrow" href={routeHref} rel="noopener">Route planen<span aria-hidden="true">→</span></a>
      </div>
      <div class="visit__hours" data-reveal style="--d: 150ms">
        <p class="label">Öffnungszeiten</p>
        <HoursTable />
        <OpenStatus class="visit__status" />
      </div>
    </section>

    <section class="offers page" aria-label="Mittagstisch, Catering und Gutscheine" data-reveal-stagger="120">
      <div class="offer" data-reveal>
        <p class="label">Mittagstisch</p>
        <p class="offer__big display">ab 9,90 €</p>
        <p class="offer__text">Jeden Tag ein anderes Gericht mit Reis. Was es heute gibt, erfährst du vor Ort oder am Telefon.</p>
      </div>
      <div class="offer" data-reveal>
        <p class="label">Catering und Firmen</p>
        <p class="offer__mid display">Ab 10 Shawarma liefern wir.</p>
        <p class="offer__text">An Firmen in {restaurant.city}. Für Feiern: die Elmo-Grill Platte für 4 Personen, 80,00 €.</p>
        <a class="link-arrow offer__link" href="/catering">Catering anfragen<span aria-hidden="true">→</span></a>
      </div>
      <div class="offer" data-reveal>
        <p class="label">Gutscheine</p>
        <p class="offer__mid display">Genuss <em>verschenken.</em></p>
        <p class="offer__text">Im Restaurant oder auf Anfrage am Telefon.</p>
        <a class="link-arrow offer__link" href="/gutscheine">Zu den Gutscheinen<span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="museum page" aria-labelledby="museum-title">
      <div data-reveal-stagger="110">
        <p class="label" data-reveal>Das Museum im Flur</p>
        <h2 id="museum-title" class="display museum__title" data-reveal="mask"><span class="mask__in">{count} Bilder, {count.toLowerCase()} <em>Geschichten.</em></span></h2>
        <p class="museum__text" data-reveal>
          Orte aus dem Libanon und aus Jerusalem hängen bei uns im Flur. Scan den Code neben einem Bild oder lies alle
          Geschichten hier.
        </p>
        <a class="link-arrow" href="/museum" data-reveal>Zum Museum<span aria-hidden="true">→</span></a>
      </div>
      <div class="museum__images">
        {
          museumImages.map((item, i) => (
            <a class="museum__link" href={item.href} aria-label={`Station ${item.id}: ${item.title}`}>
              <Arch
                reveal
                image={item.image}
                alt={item.alt}
                sizes="(min-width: 64rem) 16rem, 30vw"
                class:list={['museum__arch', { 'museum__arch--tall': item.tall }]}
                style={`--d: ${i * 140}ms`}
              />
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ---------- Titelbild ---------- */
  .hero {
    position: relative;
    padding-top: 1.75rem;
  }

  .hero__label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .hero__city {
    display: none;
  }

  @media (min-width: 40rem) {
    .hero__city {
      display: inline;
    }
  }

  .hero__rule {
    width: 2rem;
    height: 1px;
    background: var(--gold-line);
  }

  .hero__ar {
    font-size: 1.375rem;
    line-height: 1;
    color: var(--gold-soft);
  }

  .hero__title {
    position: relative;
    z-index: 1;
    /* Flex: die Ränder der Zeilenmasken fallen nicht zusammen, Abstände bleiben wie gesetzt */
    display: flex;
    flex-direction: column;
    margin-top: 1.25rem;
    font-size: clamp(4.5rem, 21.5vw, 11rem);
    line-height: 0.86;
  }

  /* normaler Umbruch („Frisch vom / Spieß.“), nicht ausbalanciert */
  .hero__title :global(.mask__in) {
    text-wrap: wrap;
  }

  .hero :global(.hero__arch) {
    height: clamp(24rem, 112vw, 34rem);
    margin: -2.4rem 0 0 3rem;
  }

  .hero__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .hero__text {
    max-width: 25rem;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  @media (min-width: 64rem) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 51rem;
      padding-bottom: 4.5rem;
    }

    .hero :global(.hero__arch) {
      position: absolute;
      top: 1.5rem;
      right: var(--page-pad);
      bottom: 0;
      width: min(36vw, 32.5rem);
      height: auto;
      margin: 0;
    }

    .hero__label {
      margin-top: 3.5rem;
    }

    .hero__title {
      font-size: clamp(7rem, 12.2vw, 11rem);
    }

    .hero__bottom {
      flex-direction: row;
      align-items: flex-end;
      gap: 3.5rem;
      margin-top: auto;
      padding-top: 3rem;
    }

    .hero__actions {
      align-items: flex-start;
    }
  }

  /* ---------- Handarbeit ---------- */
  .hand {
    padding-top: clamp(5.5rem, 11vw, 10rem);
  }

  .hand__head {
    display: grid;
    gap: 1.25rem;
  }

  .hand__title {
    font-size: clamp(3.5rem, 7.2vw, 6.5rem);
  }

  .hand__text {
    max-width: 30rem;
    color: var(--muted);
  }

  .hand__steps {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin: 2.25rem calc(-1 * var(--page-pad)) 0;
    padding: 0 var(--page-pad);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-pad);
    scrollbar-width: none;
  }

  .hand__step {
    flex: 0 0 15.5rem;
    scroll-snap-align: start;
  }

  .hand :global(.hand__arch--1) {
    height: 20.5rem;
  }

  .hand :global(.hand__arch--2) {
    height: 23.75rem;
  }

  .hand :global(.hand__arch--3) {
    height: 27rem;
  }

  .hand__caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.15rem 0.875rem;
    margin-top: 1.25rem;
  }

  .hand__num {
    grid-row: span 2;
    font-family: var(--font-head);
    font-style: italic;
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    line-height: 1;
    color: var(--gold);
  }

  .hand__name {
    font-size: clamp(1.75rem, 2.6vw, 2.375rem);
    line-height: 1;
  }

  .hand__desc {
    font-size: 0.9375rem;
    color: var(--muted-2);
  }

  .hand__more {
    margin-top: clamp(2.5rem, 6vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-head);
    font-style: italic;
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
    line-height: 1.3;
    color: #d9cdb6;
  }

  @media (min-width: 64rem) {
    .hand__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: end;
    }

    .hand__steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
      margin: 5.5rem 0 0;
      padding: 0;
      overflow: visible;
    }

    .hand :global(.hand__arch--1) {
      height: 30rem;
    }

    .hand :global(.hand__arch--2) {
      height: 35rem;
    }

    .hand :global(.hand__arch--3) {
      height: 40rem;
    }
  }

  /* ---------- Karte (hell) ---------- */
  .menu {
    margin-top: clamp(5.5rem, 11vw, 10rem);
    padding: clamp(4.5rem, 9vw, 8.5rem) 0 clamp(4rem, 8vw, 8rem);
    background: var(--stone);
    color: var(--ink);
  }

  .menu__foot p a {
    color: var(--ink);
  }

  .menu__head {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
  }

  .menu__title {
    font-size: clamp(5.5rem, 10.5vw, 9.5rem);
    line-height: 0.85;
  }

  .menu__meta {
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .menu__ar {
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    line-height: 1.2;
    color: var(--ink-gold);
  }

  .menu__grid {
    display: grid;
    margin-top: 2rem;
    border-top: 2px solid var(--ink);
  }

  .menu__foot {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2.5rem;
    font-size: 1rem;
    color: var(--ink-muted);
  }

  .menu__foot p a {
    font-weight: 600;
  }

  .menu .btn {
    align-self: flex-start;
  }

  @media (min-width: 64rem) {
    .menu__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }

    .menu__meta {
      text-align: right;
    }

    .menu__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 6rem;
      margin-top: 4.5rem;
    }

    .menu__col > :global(:last-child) {
      border-bottom: 0;
    }

    .menu__foot {
      flex-direction: row;
      align-items: center;
      gap: 2.25rem;
      margin-top: 4rem;
    }
  }

  /* ---------- Wurzeln ---------- */
  .roots {
    position: relative;
    display: flex;
    min-height: 35rem;
    overflow: hidden;
  }

  .roots :global(picture),
  .roots__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .roots__img {
    object-fit: cover;
  }

  .roots__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(20, 18, 14, 0.95) 0%, rgba(20, 18, 14, 0.6) 45%, rgba(20, 18, 14, 0) 75%);
  }

  .roots__body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 2.25rem;
  }

  .roots__label {
    color: var(--gold-soft);
  }

  .roots__title {
    max-width: 42.5rem;
    margin-top: 0.875rem;
    font-size: clamp(3.625rem, 7.8vw, 7rem);
  }

  .roots__text {
    max-width: 29rem;
    margin: 1rem 0 0.5rem;
    color: #e2d8c4;
  }

  @media (min-width: 64rem) {
    .roots {
      min-height: 48.75rem;
    }

    .roots__shade {
      background: linear-gradient(90deg, rgba(20, 18, 14, 0.92) 0%, rgba(20, 18, 14, 0.6) 45%, rgba(20, 18, 14, 0) 75%);
    }

    .roots__body {
      justify-content: center;
      padding-bottom: 0;
    }

    .roots__text {
      margin-top: 1.875rem;
    }
  }

  /* ---------- Besuch ---------- */
  .visit {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(5.5rem, 11vw, 10rem);
  }

  .visit__phone {
    display: block;
    margin-top: 0.875rem;
    font-size: clamp(3.625rem, 8.9vw, 8rem);
    line-height: 0.95;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .visit__text {
    max-width: 32.5rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }

  .visit__address {
    margin-top: 2rem;
    font-family: var(--font-head);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    line-height: 1.2;
  }

  .visit__hours .label {
    margin-bottom: 1rem;
  }

  .visit :global(.visit__status) {
    margin-top: 1rem;
  }

  @media (min-width: 64rem) {
    .visit {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 6rem;
    }
  }

  /* ---------- Angebote ---------- */
  .offers {
    display: grid;
    gap: 2.75rem;
    padding-top: clamp(5.5rem, 11vw, 10rem);
  }

  .offer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--gold);
  }

  .offer__big {
    margin-top: 1.25rem;
    font-size: clamp(4.5rem, 6.7vw, 6rem);
  }

  .offer__mid {
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 3.9vw, 3.5rem);
    line-height: 0.98;
  }

  .offer__text {
    margin-top: 1rem;
    color: var(--muted);
  }

  .offer__link {
    margin-top: 0.5rem;
    border-bottom: 0;
  }

  @media (min-width: 64rem) {
    .offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem;
    }
  }

  /* ---------- Museum ---------- */
  .museum {
    display: grid;
    gap: 2rem;
    padding-top: clamp(6rem, 12vw, 11rem);
  }

  .museum__title {
    margin-top: 0.875rem;
    font-size: clamp(3.375rem, 6.1vw, 5.5rem);
  }

  .museum__text {
    max-width: 26rem;
    margin: 1.5rem 0 0.5rem;
    color: var(--muted);
  }

  .museum__images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.625rem, 1.7vw, 1.5rem);
    align-items: end;
  }

  .museum__link {
    display: block;
  }

  .museum :global(.museum__arch) {
    height: clamp(10.5rem, 26vw, 23.75rem);
  }

  .museum :global(.museum__arch--tall) {
    height: clamp(12.5rem, 30.5vw, 27.5rem);
  }

  @media (min-width: 64rem) {
    .museum {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4.5rem;
      align-items: end;
    }
  }
</style>
