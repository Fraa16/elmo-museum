---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Arch from '../components/site/Arch.astro';
import CallBand from '../components/site/CallBand.astro';
import { restaurant } from '../data/restaurant';
import imgCatering from '../assets/photos/catering-drk.webp';

// TODO: Freigabe Momo.
const steps = [
  { num: '01', title: 'Anrufen', text: 'Sag uns, wie viele ihr seid, was ihr essen möchtet und wann.' },
  { num: '02', title: 'Wir bereiten zu', text: 'Alles handgemacht und frisch zubereitet, in unserer Küche in der Kapuzinergasse.' },
  { num: '03', title: 'Abholen oder geliefert', text: 'Du holst ab. Firmen in Schwäbisch Gmünd beliefern wir ab 10 Shawarma selbst.' },
];
---

<BaseLayout
  og="catering"
  title="Catering und Firmen"
  description="Grillplatten für eure Feier und Shawarma für euer Team: Ab 10 Shawarma liefert Elmo Shawarma selbst an Firmen in Schwäbisch Gmünd."
>
  <main>
    <PageHero
      label="Catering und Firmen"
      title="Für eure Feier. <em>Für euer Team.</em>"
      intro="Grillplatten für Feiern und Shawarma für Firmen in Schwäbisch Gmünd. Alles handgemacht und frisch zubereitet."
    >
      <a class="btn btn--solid hero-cta" href={restaurant.phoneHref}>Catering anfragen<span aria-hidden="true"><svg class="i-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></a>
      <Arch
        slot="aside"
        framed
        reveal
        eager
        image={imgCatering}
        alt="Catering-Buffet von Elmo Shawarma für das DRK mit Shawarma-Rollen, Falafel und Hummus"
        position="50% 24%"
        class="hero-arch"
      />
    </PageHero>

    <section class="offers page" aria-label="Angebote" data-reveal-stagger="120">
      <article class="offer" data-reveal>
        <p class="label">Firmenlieferung</p>
        <p class="display offer__big">Ab 10 <em>Shawarma</em></p>
        <p class="offer__text">liefern wir selbst an Firmen in {restaurant.city}. Bestellung per Telefon.</p>
      </article>
      <article class="offer" data-reveal>
        <p class="label">Elmo-Grill Platte</p>
        <p class="display offer__big">80,00 €</p>
        <p class="offer__text">Gemischte Grillplatte für 4 Personen.</p>
      </article>
      <article class="offer" data-reveal>
        <p class="label">Sayyudiyye</p>
        <p class="display offer__big"><em>Platte</em> für 4</p>
        <p class="offer__text">Makrele in Reis nach palästinensischer Art, dazu Salat. Preis auf Anfrage.</p>
      </article>
    </section>

    <section class="flow page" aria-labelledby="flow-title">
      <h2 id="flow-title" class="display flow__title" data-reveal="mask"><span class="mask__in">So <em>läuft es.</em></span></h2>
      <ol class="flow__list" role="list" data-reveal-stagger="120">
        {
          steps.map((step) => (
            <li class="flow__step" data-reveal>
              <span class="flow__num" aria-hidden="true">{step.num}</span>
              <h3 class="flow__name">{step.title}</h3>
              <p class="flow__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="when" data-reveal>
        <p class="label">Wann anrufen?</p>
        <dl class="when__list">
          <div class="when__item">
            <dt>Mittagessen für Firmen</dt>
            <dd>eine Stunde vorher</dd>
          </div>
          <div class="when__item">
            <dt>Events und Feiern</dt>
            <dd>eine Woche im Voraus</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="mail page" aria-label="Anfrage per E-Mail">
      <p class="mail__text" data-reveal>
        Lieber schriftlich? Schreib uns an <a href={`mailto:${restaurant.email}?subject=Catering-Anfrage`}>{restaurant.email}</a>.
      </p>
    </section>

    <CallBand label="Catering anfragen" text="Ruf an, wir besprechen Menge, Termin und Ort mit dir." />
  </main>
</BaseLayout>

<style>
  .hero-cta {
    margin-top: 2rem;
  }

  /* etwas höher als auf den anderen Seiten: Gesicht und Buffet passen so gemeinsam in den Bogen */
  :global(.hero-arch) {
    height: clamp(24rem, 112vw, 38rem);
  }

  .offers {
    display: grid;
    gap: 2.75rem;
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .offer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--gold);
  }

  .offer__big {
    margin-top: 1.25rem;
    font-size: clamp(3.5rem, 5.5vw, 5rem);
  }

  .offer__text {
    margin-top: 1rem;
    max-width: 22rem;
    color: var(--muted);
  }

  .flow {
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .flow__title {
    font-size: clamp(3.25rem, 6.5vw, 6rem);
  }

  .flow__list {
    display: grid;
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .flow__step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .flow__num {
    grid-row: span 2;
    font-family: var(--font-head);
    font-style: italic;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--gold);
  }

  .flow__name {
    font-size: 2.25rem;
    line-height: 1;
  }

  .flow__text {
    color: var(--muted);
  }

  .mail {
    padding-top: 2.5rem;
  }

  .mail__text {
    font-family: var(--font-head);
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.25;
  }

  .mail__text a {
    color: var(--gold-soft);
    overflow-wrap: anywhere;
  }

  .when {
    margin-top: 3rem;
    max-width: 44rem;
  }

  .when__list {
    margin: 0.875rem 0 0;
    border-top: 1px solid var(--line);
  }

  .when__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .when__item dt {
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
  }

  .when__item dd {
    margin: 0;
    color: var(--gold-soft);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .offers,
    .flow__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem;
    }
  }
</style>
