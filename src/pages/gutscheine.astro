---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Arch from '../components/site/Arch.astro';
import CallBand from '../components/site/CallBand.astro';
import Todo from '../components/Todo.astro';
import { restaurant } from '../data/restaurant';

// TODO: Zahlungsweg für den Online-Kauf festlegen (SumUp oder PayPal/Karte), dann den Knopf verlinken.
// TODO: Freigabe Momo: Kauf im Restaurant und Einlösung.
---

<BaseLayout
  og="gutscheine"
  title="Gutscheine"
  description="Genuss verschenken: Gutscheine von Elmo Shawarma in Schwäbisch Gmünd, für Shawarma, Grillteller und Mezze."
>
  <main>
    <PageHero
      label="Gutscheine"
      title="Genuss <em>verschenken.</em>"
      intro="Ein Gutschein für Shawarma, Grillteller und Mezze. Einlösbar bei uns in der Kapuzinergasse."
    >
      <Arch slot="aside" framed reveal placeholder="Foto: Gutschein" class="hero-arch" />
    </PageHero>

    <section class="ways page" aria-label="So bekommst du einen Gutschein" data-reveal-stagger="120">
      <article class="way" data-reveal>
        <span class="way__num" aria-hidden="true">01</span>
        <h2 class="way__title">Im Restaurant</h2>
        <p class="way__text">Gutscheine bekommst du direkt bei uns, {restaurant.street}.</p>
      </article>
      <article class="way" data-reveal>
        <span class="way__num" aria-hidden="true">02</span>
        <h2 class="way__title">Am Telefon</h2>
        <p class="way__text">Ruf an, wir legen dir den Gutschein zum Abholen bereit.</p>
        <a class="link-arrow" href={restaurant.phoneHref}>{restaurant.phone}<span aria-hidden="true"><svg class="i-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span></a>
      </article>
      <article class="way" data-reveal>
        <span class="way__num" aria-hidden="true">03</span>
        <h2 class="way__title">Online</h2>
        <p class="way__text">Bald kannst du Gutscheine hier direkt kaufen und bezahlen.</p>
        <span class="btn way__soon" aria-disabled="true">Online kaufen <Todo label="Zahlungsweg" /></span>
      </article>
    </section>

    <CallBand label="Gutschein anfragen" text="Ruf an und sag uns den Betrag, wir legen dir den Gutschein bereit." />
  </main>
</BaseLayout>

<style>
  :global(.hero-arch) {
    height: clamp(22rem, 90vw, 32rem);
  }

  .ways {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .way {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--gold);
  }

  .way__num {
    font-family: var(--font-head);
    font-style: italic;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--gold);
  }

  .way__title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
  }

  .way__text {
    max-width: 22rem;
    color: var(--muted);
  }

  .way__soon {
    opacity: 0.7;
    cursor: default;
  }

  .way__soon:hover {
    background: transparent;
    color: var(--gold-soft);
  }

  @media (min-width: 64rem) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem;
    }
  }
</style>
