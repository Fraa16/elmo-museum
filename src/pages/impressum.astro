---
import '../styles/legal.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Todo from '../components/Todo.astro';
import { CITY, RESTAURANT } from '../config';
import { restaurant } from '../data/restaurant';

// TODO: Daten von Momo: restliche <Todo>-Platzhalter ersetzen, Vorname des Inhabers ausschreiben,
// rechtlich prüfen lassen.
---

<BaseLayout title="Impressum" description={`Impressum von ${RESTAURANT}, ${CITY}`}>
  <main class="legal wrap prose">
    <p class="kicker">Rechtliches</p>
    <h1>Impressum</h1>

    <p class="legal__draft">Entwurf: Die markierten Angaben fehlen noch und werden vor der Veröffentlichung ergänzt.</p>

    <h2>Angaben gemäß § 5 DDG</h2>
    <address>
      {RESTAURANT}<br />
      Inhaber: {restaurant.owner}<br />
      {restaurant.street}<br />
      {restaurant.postalCode} {CITY}
    </address>

    <h2>Kontakt</h2>
    <p>
      Telefon: <a href={restaurant.phoneHref}>{restaurant.phone}</a><br />
      E-Mail: <a href={`mailto:${restaurant.email}`}>{restaurant.email}</a>
    </p>

    <h2>Umsatzsteuer-ID</h2>
    <p>
      Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz: <Todo label="USt-IdNr., falls vorhanden" />
    </p>

    <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
    <p><Todo label="Name und Anschrift" /></p>

    <h2>Bildnachweise</h2>
    <p><Todo label="Bildrechte der Wandbilder klären" /></p>
    <p class="legal__small">
      Station 11: Sliman Mansour, Jamal al-Mahamel III, Dalloul Art Foundation, Beirut.<br />
      Alle Bilder im Museum wurden mit KI bearbeitet. Emblem: {RESTAURANT}.
    </p>
  </main>
</BaseLayout>
