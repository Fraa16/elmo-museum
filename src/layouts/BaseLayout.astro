---
import '@fontsource/cinzel/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../styles/global.css';
// Fließtext- und Headline-Schrift vorladen: verhindert Layoutsprünge beim Schriftwechsel.
import sans400 from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import sans600 from '@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url';
import head600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';

import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import { INDEXABLE, SITE_NAME, SITE_URL } from '../config';

interface Props {
  /** Seitentitel ohne Zusatz; „| Elmo Museum“ wird angehängt. */
  title: string;
  description?: string;
  /** Absolute URL des Open-Graph-Bilds (WhatsApp-Vorschau). */
  ogImage?: string;
  ogImageAlt?: string;
  /** Erzwingt noindex, auch wenn INDEXABLE = true (z. B. QR-Bogen, 404). */
  noindex?: boolean;
  /** Topbar rechts, z. B. { current: 2, total: 9 }. */
  counter?: { current: number; total: number };
  /** Topbar und Footer anzeigen (für die Druckseite abschaltbar). */
  chrome?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = 'Scan den Code neben einem Bild und entdecke seine Geschichte. Das kleine Museum im Flur von Elmo Shawarma in Schwäbisch Gmünd.',
  ogImage,
  ogImageAlt,
  noindex = false,
  counter,
  chrome = true,
  bodyClass,
} = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const robots = INDEXABLE && !noindex ? 'index, follow' : 'noindex, nofollow';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, SITE_URL).href;
// Fehlerseite und Druckbogen bekommen keinen Canonical-Link.
const showCanonical = !noindex;
// Das Inline-Skript im <head> setzt `.js` vor dem ersten Rendern:
// Rate-Element zeigen, Einblendungen aktivieren, ohne Layoutsprung.
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {showCanonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#141413" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {[sans400, sans600, head600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {chrome && <Topbar counter={counter} />}
    <slot />
    {chrome && <Footer />}

    <script>
      // Textabsätze beim Scrollen leicht einblenden (nur mit JS, siehe .reveal in global.css).
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (items.length && 'IntersectionObserver' in window && !reduced) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -5% 0px' },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
