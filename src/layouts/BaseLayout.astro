---
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
// Fließtext- und Headline-Schrift vorladen: verhindert Layoutsprünge beim Schriftwechsel.
import sans400 from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import sans600 from '@fontsource/instrument-sans/files/instrument-sans-latin-600-normal.woff2?url';
import serif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import MuseumBar from '../components/MuseumBar.astro';
import { INDEXABLE, MUSEUM_NAME, SITE_NAME, SITE_URL } from '../config';

interface Props {
  /** Seitentitel ohne Zusatz; „| Elmo Shawarma“ bzw. „| Elmo Museum“ wird angehängt. */
  title: string;
  /** Kompletter Titel ohne Zusatz (Startseite). */
  fullTitle?: string;
  description?: string;
  /**
   * Vorschaubild (WhatsApp, Facebook): Name eines Bilds aus /public/og/
   * (npm run og), z. B. „speisekarte“. Standard: „start“.
   */
  og?: string;
  /** Eigenes Vorschaubild als absolute URL, z. B. das Foto einer Museumsstation. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Erzwingt noindex, auch wenn INDEXABLE = true (z. B. QR-Bogen, 404). */
  noindex?: boolean;
  /** Museumsleiste rechts, z. B. { current: 2, total: 11 }. */
  counter?: { current: number; total: number };
  /** Kopfzeile und Fußzeile anzeigen (für die Druckseite abschaltbar). */
  chrome?: boolean;
  bodyClass?: string;
}

const {
  title,
  fullTitle: fullTitleProp,
  description = 'Libanesische und palästinensische Küche in Schwäbisch Gmünd. Shawarma vom Spieß, Grillteller und Mezze, alles handgemacht und frisch zubereitet.',
  og = 'start',
  ogImage: ogImageProp,
  ogImageAlt: ogImageAltProp,
  noindex = false,
  counter,
  chrome = true,
  bodyClass,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const inMuseum = path === '/museum' || path.startsWith('/museum/');
const suffix = inMuseum ? MUSEUM_NAME : SITE_NAME;
const fullTitle = fullTitleProp ?? (title === suffix ? title : `${title} | ${suffix}`);
const robots = INDEXABLE && !noindex ? 'index, follow' : 'noindex, nofollow';
// Vorschaubild: eigenes Foto (Museumsstation) oder gestaltetes Bild aus /public/og/ (1200 × 630)
const ogImage = ogImageProp ?? new URL(`/og/${og}.jpg`, SITE_URL).href;
const ogImageAlt = ogImageAltProp ?? `${fullTitle}: Vorschau`;
const ogSize = ogImageProp ? null : { width: 1200, height: 630 };
const canonical = new URL(path, SITE_URL).href;
// Fehlerseite und Druckbogen bekommen keinen Canonical-Link.
const showCanonical = !noindex;
// Das Inline-Skript im <head> setzt `.js` vor dem ersten Rendern:
// Rate-Element zeigen, Einblendungen aktivieren, ohne Layoutsprung.
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {showCanonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#14120e" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {[sans400, sans600, serif400].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {chrome && <SiteHeader />}
    {chrome && inMuseum && <MuseumBar counter={counter} />}
    <slot />
    {chrome && <SiteFooter />}

    <script>
      // Bewegung nur mit JS und ohne „Bewegung reduzieren“ (siehe global.css).
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Museum: .reveal → .is-visible; Website: [data-reveal] → .is-in
      const museum = document.querySelectorAll<HTMLElement>('.reveal');
      const site = document.querySelectorAll<HTMLElement>('[data-reveal]');

      /*
       * Staffelung nach Eintritt: Nur Elemente, die im selben Moment ins Bild
       * kommen, starten nacheinander (data-reveal-stagger am Elternteil, Abstand
       * in ms, höchstens 3 Stufen). Wer allein kommt, startet sofort. So passt es
       * auf dem Desktop (nebeneinander) und auf dem Handy (untereinander).
       * data-reveal-offset: feste Zusatzverzögerung, z. B. Bildunterschrift.
       */
      const stagger = (batch: HTMLElement[]) => {
        const groups = new Map<HTMLElement, HTMLElement[]>();
        for (const el of batch) {
          const parent = el.closest<HTMLElement>('[data-reveal-stagger]');
          if (!parent) continue;
          if (!groups.has(parent)) groups.set(parent, []);
          groups.get(parent)!.push(el);
        }
        groups.forEach((els, parent) => {
          const step = Number(parent.dataset.revealStagger) || 80;
          const itemOf = (el: HTMLElement) => {
            let item = el;
            while (item.parentElement && item.parentElement !== parent) item = item.parentElement;
            return item;
          };
          const items = [...new Set(els.map(itemOf))].sort((a, b) =>
            a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
          );
          for (const el of els) {
            const index = Math.min(items.indexOf(itemOf(el)), 3);
            const offset = Number(el.dataset.revealOffset) || 0;
            el.style.setProperty('--d', `${index * step + offset}ms`);
          }
        });
      };

      if ('IntersectionObserver' in window && !reduced) {
        // Verzögerungen im Seitenkopf (data-reveal-intro) gelten nur beim Laden;
        // wer erst später ins Bild gescrollt wird, startet sofort.
        let initial = true;
        const observer = new IntersectionObserver(
          (entries) => {
            const batch: HTMLElement[] = [];
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              observer.unobserve(el);
              if (el.classList.contains('reveal')) {
                el.classList.add('is-visible');
                continue;
              }
              if (!initial && el.closest('[data-reveal-intro]')) el.style.setProperty('--d', '0ms');
              batch.push(el);
            }
            stagger(batch);
            const reveal = () => batch.forEach((el) => el.classList.add('is-in'));
            // Beim ersten Mal zwei Frames warten: Der Browser muss den Startzustand
            // einmal gezeichnet haben, sonst springt der Seitenkopf ohne Übergang.
            if (initial) requestAnimationFrame(() => requestAnimationFrame(reveal));
            else reveal();
            initial = false;
          },
          { rootMargin: '0px 0px -4% 0px' },
        );
        museum.forEach((item) => observer.observe(item));
        site.forEach((item) => observer.observe(item));
      } else {
        museum.forEach((item) => item.classList.add('is-visible'));
        site.forEach((item) => item.classList.add('is-in'));
      }

      // Parallax: Bild wandert beim Scrollen um wenige Prozent gegen die Scrollrichtung.
      const layers = document.querySelectorAll<HTMLElement>('[data-parallax]');
      const desktop = window.matchMedia('(min-width: 64rem) and (hover: hover) and (pointer: fine)').matches;
      if (layers.length && !reduced && desktop) {
        let queued = false;
        const update = () => {
          queued = false;
          const vh = window.innerHeight;
          layers.forEach((layer) => {
            const box = (layer.closest('[data-parallax-box]') ?? layer.parentElement)!.getBoundingClientRect();
            if (box.bottom < 0 || box.top > vh) return;
            const progress = (box.top + box.height / 2 - vh / 2) / (vh / 2 + box.height / 2);
            layer.style.transform = `translate3d(0, ${(progress * -5).toFixed(2)}%, 0) scale(1.12)`;
          });
        };
        const queue = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue);
        update();
      }
    </script>
  </body>
</html>
