---
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
// Fließtext- und Headline-Schrift vorladen: verhindert Layoutsprünge beim Schriftwechsel.
import sans400 from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import sans600 from '@fontsource/instrument-sans/files/instrument-sans-latin-600-normal.woff2?url';
import serif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import MuseumBar from '../components/MuseumBar.astro';
import { INDEXABLE, MUSEUM_NAME, SITE_NAME, SITE_URL } from '../config';

interface Props {
  /** Seitentitel ohne Zusatz; „| Elmo Shawarma“ bzw. „| Elmo Museum“ wird angehängt. */
  title: string;
  /** Kompletter Titel ohne Zusatz (Startseite). */
  fullTitle?: string;
  description?: string;
  /** Absolute URL des Open-Graph-Bilds (WhatsApp-Vorschau). */
  ogImage?: string;
  ogImageAlt?: string;
  /** Erzwingt noindex, auch wenn INDEXABLE = true (z. B. QR-Bogen, 404). */
  noindex?: boolean;
  /** Museumsleiste rechts, z. B. { current: 2, total: 11 }. */
  counter?: { current: number; total: number };
  /** Kopfzeile und Fußzeile anzeigen (für die Druckseite abschaltbar). */
  chrome?: boolean;
  bodyClass?: string;
}

const {
  title,
  fullTitle: fullTitleProp,
  description = 'Libanesische und palästinensische Küche in Schwäbisch Gmünd. Shawarma vom Spieß, Grillteller und Mezze, alles handgemacht und frisch zubereitet.',
  ogImage,
  ogImageAlt,
  noindex = false,
  counter,
  chrome = true,
  bodyClass,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const inMuseum = path === '/museum' || path.startsWith('/museum/');
const suffix = inMuseum ? MUSEUM_NAME : SITE_NAME;
const fullTitle = fullTitleProp ?? (title === suffix ? title : `${title} | ${suffix}`);
const robots = INDEXABLE && !noindex ? 'index, follow' : 'noindex, nofollow';
const canonical = new URL(path, SITE_URL).href;
// Fehlerseite und Druckbogen bekommen keinen Canonical-Link.
const showCanonical = !noindex;
// Das Inline-Skript im <head> setzt `.js` vor dem ersten Rendern:
// Rate-Element zeigen, Einblendungen aktivieren, ohne Layoutsprung.
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {showCanonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#14120e" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {[sans400, sans600, serif400].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {chrome && <SiteHeader />}
    {chrome && inMuseum && <MuseumBar counter={counter} />}
    <slot />
    {chrome && <SiteFooter />}

    <script>
      // Bewegung nur mit JS und ohne „Bewegung reduzieren“ (siehe global.css).
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Gruppen: Kinder nacheinander einblenden (data-reveal-stagger="80" = 80 ms Abstand).
      document.querySelectorAll<HTMLElement>('[data-reveal-stagger]').forEach((group) => {
        const step = Number(group.dataset.revealStagger) || 90;
        group.querySelectorAll<HTMLElement>('[data-reveal]').forEach((item, i) => {
          if (!item.style.getPropertyValue('--d')) item.style.setProperty('--d', `${i * step}ms`);
        });
      });

      // Museum: .reveal → .is-visible; Website: [data-reveal] → .is-in
      const museum = document.querySelectorAll<HTMLElement>('.reveal');
      const site = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if ('IntersectionObserver' in window && !reduced) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.classList.add(el.classList.contains('reveal') ? 'is-visible' : 'is-in');
              observer.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        museum.forEach((item) => observer.observe(item));
        site.forEach((item) => observer.observe(item));
      } else {
        museum.forEach((item) => item.classList.add('is-visible'));
        site.forEach((item) => item.classList.add('is-in'));
      }

      // Parallax: Bild wandert beim Scrollen um wenige Prozent gegen die Scrollrichtung.
      const layers = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (layers.length && !reduced) {
        let queued = false;
        const update = () => {
          queued = false;
          const vh = window.innerHeight;
          layers.forEach((layer) => {
            const box = (layer.closest('[data-parallax-box]') ?? layer.parentElement)!.getBoundingClientRect();
            if (box.bottom < 0 || box.top > vh) return;
            const progress = (box.top + box.height / 2 - vh / 2) / (vh / 2 + box.height / 2);
            layer.style.transform = `translate3d(0, ${(progress * -5).toFixed(2)}%, 0) scale(1.12)`;
          });
        };
        const queue = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue);
        update();
      }
    </script>
  </body>
</html>
